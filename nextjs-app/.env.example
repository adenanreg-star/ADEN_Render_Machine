# Google AI Studio API key (https://aistudio.google.com/apikey).
# Hanya dibaca di server oleh app/api/gemini/route.js.
# Salin file ini menjadi .env.local untuk development, lalu isi nilainya.
# Jangan pakai prefix NEXT_PUBLIC_ dan jangan commit nilai aslinya.
GEMINI_API_KEY=

# --- Fallback penyedia teks (opsional; dipakai berurutan bila Gemini gagal) ---
# Urutan: gemini-3.5-flash-lite -> gemini-3.1-flash-lite -> Groq -> OpenRouter free.
# Tanpa key di bawah, penyedia tersebut otomatis dilewati.
# Groq (https://console.groq.com/keys): qwen/qwen3.8-27b.
# GROQ_API_KEY=
# OpenRouter (https://openrouter.ai/keys): model gratis ber-vision.
# OPENROUTER_API_KEY=


# --- Cloudflare Workers AI: cadangan GAMBAR bila Gemini menolak (429/kuota) ---
# Gratis 10.000 neuron/hari (tanpa kartu). Buat token di
# https://dash.cloudflare.com/profile/api-tokens dengan template "Workers AI",
# lalu salin Account ID dari sidebar dashboard. Tanpa kedua nilai ini, cadangan
# Cloudflare dilewati otomatis. Hanya dipakai untuk model gambar; rantai teks
# tidak berubah.
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# Model gambar Workers AI (default @cf/black-forest-labs/flux-2-klein-4b).
# Catatan: model ini hanya menerima gambar input lebih kecil dari 512x512,
# jadi frontend otomatis mengirim salinan kecil (fallbackImages) khusus untuk
# jalur cadangan ini; Gemini tetap memakai foto resolusi penuh.
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# --- Store bersama untuk rate limit & kuota (D1, binding `DB`) ---
# Counter disimpan di D1 sehingga berlaku lintas instance dan lintas lokasi.
# Tidak ada env var yang perlu diisi: binding `DB` dipasang oleh platform saat
# deploy, dan tabel `rate_limits` dibuat otomatis pada permintaan pertama.
# Tanpa binding tersebut (mis. next dev lokal), counter kembali ke memori proses
# dan batas hanya berlaku per instance.

# --- Batas pemakaian (opsional, nilai di bawah adalah default) ---
# RATE_LIMIT_MAX_REQUESTS=30
# RATE_LIMIT_WINDOW_SECONDS=600
# Kuota render per IP dalam 24 jam bergulir (hanya model gambar).
# DAILY_IMAGE_QUOTA=60
# Anggaran render global per hari UTC, berlaku semua IP (mencegah satu atau
# banyak IP menghabiskan kuota penyedia).
# DAILY_IMAGE_BUDGET=300
# Batas waktu panggilan gambar ke Gemini; setelah lewat, fallback Cloudflare
# dicoba.
# GEMINI_IMAGE_TIMEOUT_SECONDS=100
# Ukuran gambar keluaran termahal yang diizinkan: 512, 1K, 2K, atau 4K.
# MAX_IMAGE_SIZE=1K
